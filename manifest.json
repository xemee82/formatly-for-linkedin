{
  "manifest_version": 3,
  "name": "LinkedIn Inline Formatter",
  "version": "1.0.0",
  "description": "Select text in LinkedIn editor, format instantly with bold, italic, and more Unicode styles.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*",
        "http://localhost:*/*"
      ],
      "js": [
        "content/unicode-map.js",
        "content/selection.js",
        "content/toolbar.js",
        "content/replacer.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
